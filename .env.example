# Copy this file to .env and fill in the values. .env is not committed.
# On Vercel, set the same variables in Settings > Environment Variables, then redeploy:
# NEXT_PUBLIC_ values are fixed at build time.

# GoHighLevel inbound webhook for the /contact form. Leave empty to keep the form
# offline (it then asks visitors to email instead).
NEXT_PUBLIC_GHL_WEBHOOK_URL=

# Sanity (blog studio storage, docs/sanity.md). Project ID and dataset are public values.
# The deployed studio writes to Sanity only after the team signs in (STUDIO_* below, decision.md D030).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Server-only. Sanity > API > Tokens, "Editor" permission. Never prefix with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# Blog studio team sign-in (decision.md D030, D031). Server-only. Without BOTH (valid), the studio
# is locked behind a "Blog Studio unavailable" dialog: it does not open at all, locally or deployed. Password: 12+ characters, 8+
# different ones, no guessable words (same rule locally and in Production; longer is better, e.g. four
# random words, or `openssl rand -base64 24`).
# Secret: 32+ random characters (`openssl rand -hex 32`), different from the password.
# Changing either signs everyone out.
#
# Vercel: set SANITY_API_WRITE_TOKEN and STUDIO_* on PRODUCTION only, with
# NEXT_PUBLIC_SANITY_DATASET=production there. Preview gets the project ID and
# NEXT_PUBLIC_SANITY_DATASET=development, never the token or STUDIO_*: Preview cannot publish and
# ignores them. Production refuses to write unless the dataset is exactly "production".
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
