# Copy this file to .env and fill in the values. .env is not committed.
# On Vercel, set the same variables in Settings > Environment Variables, then redeploy:
# NEXT_PUBLIC_ values are fixed at build time.

# GoHighLevel inbound webhook for the /contact form. Leave empty to keep the form
# offline (it then asks visitors to email instead).
NEXT_PUBLIC_GHL_WEBHOOK_URL=
